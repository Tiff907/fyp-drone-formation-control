<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>llm_refinement</name>
  <version>0.0.0</version>
  <description>Natural-language formation refinement: generates and executes Claude-produced code to transform a point set</description>
  <maintainer email="tc20040709@gmail.com">tiffany</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>formation_msgs</depend>
  <depend>geometry_msgs</depend>

  <!-- Claude Sonnet API client (anthropic SDK) - PyPI-only,
       install manually: pip install anthropic -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
