<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>formation_gazebo</name>
  <version>0.0.0</version>
  <description>Gazebo Fortress simulation assets: kinematic drone model and formation test world</description>
  <maintainer email="tc20040709@gmail.com">tiffany</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- Fortress + Humble: try ros_gz_sim first; if not found via rosdep,
       fall back to ros_ign_sim (pre-rename package name) -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
