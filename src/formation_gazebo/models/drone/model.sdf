<?xml version="1.0"?>
<sdf version="1.9">
  <model name="drone">
    <link name="base_link">
      <gravity>false</gravity>
      <inertial>
        <mass>0.03</mass>
        <inertia>
          <ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00004</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- Central body: doubles as the LED diffuser housing -->
      <visual name="body_visual">
        <geometry>
          <sphere><radius>0.03</radius></sphere>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <emissive>0.8 0.8 0.8 1</emissive>
        </material>
      </visual>
      <collision name="body_collision">
        <geometry>
          <cylinder><radius>0.075</radius><length>0.03</length></cylinder>
        </geometry>
      </collision>

      <!-- Protective cage ring (thin torus-like ring approximated
           with 8 small connecting struts around the perimeter) -->
      <visual name="cage_ring">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.075</radius><length>0.006</length></cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 0.35</ambient>
          <diffuse>0.1 0.1 0.1 0.35</diffuse>
        </material>
        <transparency>0.6</transparency>
      </visual>

      <!-- 4 propellers nested inside the cage, X configuration -->
      <visual name="prop_fr"><pose>0.05 -0.05 0.005 0 0 0</pose>
        <geometry><cylinder><radius>0.018</radius><length>0.002</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 0.6</ambient></material></visual>
      <visual name="prop_fl"><pose>0.05 0.05 0.005 0 0 0</pose>
        <geometry><cylinder><radius>0.018</radius><length>0.002</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 0.6</ambient></material></visual>
      <visual name="prop_br"><pose>-0.05 -0.05 0.005 0 0 0</pose>
        <geometry><cylinder><radius>0.018</radius><length>0.002</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 0.6</ambient></material></visual>
      <visual name="prop_bl"><pose>-0.05 0.05 0.005 0 0 0</pose>
        <geometry><cylinder><radius>0.018</radius><length>0.002</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 0.6</ambient></material></visual>

      <!-- LED light source, colour updated at runtime to match
           point_colors / candidate_colors from formation_msgs.
           Positioned at body centre so it lights the diffuser sphere. -->
      <light name="led_light" type="point">
        <pose>0 0 0 0 0 0</pose>
        <diffuse>1 1 1 1</diffuse>
        <specular>0.5 0.5 0.5 1</specular>
        <attenuation>
          <range>2.0</range>
          <constant>0.1</constant>
          <linear>0.3</linear>
          <quadratic>0.2</quadratic>
        </attenuation>
        <cast_shadows>false</cast_shadows>
      </light>
    </link>
  </model>
</sdf>
